    <RootNamespace>Security.Persistence</RootNamespace>
    <AssemblyName>Security.Persistence</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
